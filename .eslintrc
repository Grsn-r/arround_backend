{
    "extends": "airbnb-base",
    "rules": {
        "no-underscore-dangle": [
            "error", 
            {
                "allow": ["_id"]
            }
        ],
        "no-console": "off",
        "indent": ["error", 2],
        "no-unused-vars": [
            "error", 
            { "argsIgnorePattern": "next" }]
    }
}